<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.org/POM/4.0.0
                             http://maven.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    SM8 Spark Connector — the engine-portable adapter for Apache Spark.

    Per [[scala-spark-batch-bugs-mindset]] mantra #1: this module is
    the ONLY place in the reactor allowed to depend on
    org.apache.spark:*. The inverted `enforce-no-spark` rule
    pattern (every other module uses `bannedDependencies=org.apache.spark:*`;
    THIS module uses `requireUpperBoundDeps`) makes that
    architectural boundary mechanical.

    Per agile-kindling-beacon plan line 287: "Each becomes a Plugin
    that .use()s itself." This module hosts the Spark impl of
    `MCPEngineProvider` (the production abstraction per ADR-001
    §P1-3 + ADR-006 Post-#65). The legacy `SparkConnector`
    (Connector-trait skeleton) was deleted in PR-95 (ADR-008-P
    §AR-P1-1, 2026-08-18) per the Connector → MCPEngineProvider
    migration tracked by AR-P1-7.

    Per [[karpathy-guidelines-mindset]] "smallest correct core":
    Step 8 ships the skeleton — real Spark Connect runtime lands in
    a follow-up PR after the cluster is provisioned.
  -->

  <parent>
    <groupId>io.sm8</groupId>
    <artifactId>sm8-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>spark-connector_2.13</artifactId>
  <packaging>jar</packaging>

  <name>SM8 Spark Connector</name>
  <description>Engine-portable adapter for Apache Spark. The only reactor module allowed to depend on org.apache.spark:* (closed-over types verified Serializable per the closure-safety lockdown PR #36).</description>

  <dependencies>
    <dependency>
      <groupId>io.sm8</groupId>
      <artifactId>sm8-core_2.13</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Spark core + sql: the engine-portable adapter surface. Spark 3.5
         matches the locked tech stack (agile-kindling-beacon.md table). -->
    <dependency>
      <groupId>org.apache.spark</groupId>
      <artifactId>spark-core_2.13</artifactId>
      <version>${spark.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.spark</groupId>
      <artifactId>spark-sql_2.13</artifactId>
      <version>${spark.version}</version>
    </dependency>

    <!-- Contract-test base classes — pulled from sm8-core's test-jar
         so the Connector conformance spec ships to Plugin authors. -->
    <dependency>
      <groupId>io.sm8</groupId>
      <artifactId>sm8-core_2.13</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.scalatest</groupId>
      <artifactId>scalatest_${scala.binary.version}</artifactId>
      <version>${scalatest.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>net.alchim31.maven</groupId>
        <artifactId>scala-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>

      <!-- INVERTED enforcer: this module ALLOWS org.apache.spark:* —
           the rest of the reactor EXCLUDES it via the same rule in
           their own poms. Per [[scala-spark-batch-bugs-mindset]] mantra #1:
           the Spark types (DataFrame, StorageLevel, SparkSession) are
           closed-over here; the new contract from PR #36
           (`Plugin extends java.io.Serializable` + the
           `closedOverVars` introspection) catches a future
           regression if a non-Serializable Spark class slips in.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-spark-only-in-spark-connector</id>
            <goals><goal>enforce</goal></goals>
          </execution>
        </executions>
        <configuration>
          <rules>
            <bannedDependencies>
              <excludes>
                <!-- spark-connector is the ONLY module that should depend
                     on org.apache.spark. The other modules' poms have
                     `enforce-no-spark` rules. This module does NOT
                     re-state the exclusion — its purpose is to host
                     Spark.

                     The narrower bans below enforce RFC §3 Core Boundary:
                     one connector module per engine. Catches test-scope
                     or contributor-introduced violations where another
                     engine's types leak into the spark connector (e.g.
                     `import io.sm8.duckdb._` in a spark file).
                     Per ADR-008-P §AR-P1-5 review (PR-97, 2026-08-18). -->
                <exclude>org.apache.kafka:kafka-clients</exclude>
                <!-- Other engines: forbidden here. -->
                <exclude>org.apache.flink:*</exclude>
                <exclude>io.trino:*</exclude>
                <exclude>org.apache.duckdb:*</exclude>
                <exclude>com.facebook.presto:*</exclude>
                <!-- Future SM8 engine modules: forbidden here (tracked by ADR-008-P §"Post-v0.1.0"). -->
                <exclude>io.sm8:duckdb-connector_2.13</exclude>
                <exclude>io.sm8:unity-catalog-connector_2.13</exclude>
                <exclude>io.sm8:hive-metastore-connector_2.13</exclude>
                <exclude>io.sm8:postgresql-connector_2.13</exclude>
                <!-- Trino: forbidden here (only the trino-connector module may host it). -->
                <exclude>io.sm8:trino-connector_2.13</exclude>
                <!-- In-memory connector: forbidden here (only the in-memory-connector test module may host it). -->
                <exclude>io.sm8:in-memory-connector_2.13</exclude>
              </excludes>
            </bannedDependencies>
          </rules>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.scalatest</groupId>
        <artifactId>scalatest-maven-plugin</artifactId>
        <executions>
          <execution><id>test</id><goals><goal>test</goal></goals><phase>test</phase></execution>
        </executions>
        <configuration>
          <argLine>
            -ea
            -Xmx1024m
            -Dfile.encoding=UTF-8
            --add-opens=java.base/java.lang=ALL-UNNAMED
            --add-opens=java.base/java.lang.invoke=ALL-UNNAMED
            --add-opens=java.base/java.lang.reflect=ALL-UNNAMED
            --add-opens=java.base/java.io=ALL-UNNAMED
            --add-opens=java.base/java.net=ALL-UNNAMED
            --add-opens=java.base/java.nio=ALL-UNNAMED
            --add-opens=java.base/sun.nio.ch=ALL-UNNAMED
            --add-opens=java.base/sun.nio.cs=ALL-UNNAMED
            --add-opens=java.base/sun.security.action=ALL-UNNAMED
          </argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <executions>
          <execution><id>attach-sources</id><goals><goal>jar-no-fork</goal></goals></execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
