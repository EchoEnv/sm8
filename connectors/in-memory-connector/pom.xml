<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    SM8 in-memory Connector — the built-in reference.

    Used for tests, examples, and any deployment that needs a
    data source "in process" (e.g. a small lookup table held in
    memory). Follows the same shape real Connectors
    (`spark-connector`, `trino-connector`, etc.) will follow —
    i.e. it lives in its own Maven module, depends on `sm8-core`,
    and ships as a separate JAR via the Portal.

    This module provides the built-in in-process data source via
    the `EngineProvider` seam. Conformance is validated by this
    module's own provider test suites (typed `realize` grammar +
    routing tests).
  -->

  <parent>
    <groupId>io.sm8</groupId>
    <artifactId>sm8-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>in-memory-connector_2.13</artifactId>
  <packaging>jar</packaging>

  <name>SM8 in-memory Connector</name>
  <description>Built-in in-process data source for SM8. Conformance validated by per-connector EngineProvider test suites.</description>

  <dependencies>
    <dependency>
      <groupId>io.sm8</groupId>
      <artifactId>sm8-core_2.13</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!--
      Test-jar classifier — pulls in the contract bases
      (HookContractSpec, PluginContractSpec) from sm8-core's
      src/test/. The bases ARE test infrastructure that ships to
      Plugin authors so their specs can extend them.
    -->
    <dependency>
      <groupId>io.sm8</groupId>
      <artifactId>sm8-core_2.13</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.scalatest</groupId>
      <artifactId>scalatest_${scala.binary.version}</artifactId>
      <version>${scalatest.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>net.alchim31.maven</groupId>
        <artifactId>scala-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>

      <!--
        Banned-dependencies rule — same Spark guard as sm8-core.
        Without this, nothing prevents a future contributor from
        accidentally adding org.apache.spark:* as a dep to a
        "Spark-free" connector.
      -->
      
      <!--
        Zero-Spark invariant per ADR-008-AD v1.1.
        Future contributors: this per-module block is REQUIRED (Maven
        inheritance semantics — <build><plugins> in parent does NOT auto-
        apply executions). The block is identical across all non-spark-
        connector modules; when adding a new module, copy this block.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-no-spark</id>
            <goals><goal>enforce</goal></goals>
          </execution>
        </executions>
        <configuration>
          <rules>
            <bannedDependencies>
              <excludes>
                <exclude>org.apache.spark:*</exclude>
              </excludes>
              <message>
                ${project.artifactId} must remain Spark-free. Spark
                classes live in spark-connector, not here.
              </message>
            </bannedDependencies>
          </rules>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.scalatest</groupId>
        <artifactId>scalatest-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>test</id>
            <goals><goal>test</goal></goals>
            <phase>test</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals><goal>jar-no-fork</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>