<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    SM8 Server — the runnable deployment module.

    Per ADR-006 Post-#65 Refinement (2026-08-15):
    - Owns CLI parsing (entry-point args)
    - Owns ServiceLoader-based EngineProvider discovery
    - Owns the typed (String) ctor realization (the connector
      owns the actual `SparkSession.builder(url).getOrCreate()`)
    - Owns JVM lifecycle hooks (shutdown, port release)

    The transport library (`sm8-platform`) is pure transport:
    no ServiceLoader, no reflection, no deployment concerns.
    See RFC §11a Deployment Module.

    Per karphyguidsmindset: this module is the smallest possible
    composition layer — calls `io.sm8.platform.query.Main.run(args)`
    after wiring the discovery + cache.
  -->

  <parent>
    <groupId>io.sm8</groupId>
    <artifactId>sm8-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>sm8-server_2.13</artifactId>
  <packaging>jar</packaging>

  <name>SM8 Server</name>
  <description>Runnable deployment module — CLI parsing, ServiceLoader discovery, JVM lifecycle. Pure transport lives in sm8-platform.</description>

  <dependencies>
    <dependency>
      <groupId>io.sm8</groupId>
      <artifactId>sm8-platform_2.13</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- PR-263 (ADR-014): the MCP SDK (transitive from sm8-platform)
         uses json-schema-validator 3.0.6's Dialects class at .build()
         time. sm8-core's ManifestValidator uses the same package but
         with 1.5.2's SpecVersion.VersionFlag class. The two versions
         can't coexist (same package, different shapes), so we DON'T
         put json-schema-validator here — McpHttpRoute.buildServer
         disables tool-input validation (.validateToolInputs(false))
         which removes the SDK's call to getSchemaValidator() entirely.
         v1 ships with an empty tool list; no schema needed. -->
    <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-annotations</artifactId>
        <version>2.21</version>
    </dependency>
    <dependency>
        <groupId>org.scalatest</groupId>
        <artifactId>scalatest_${scala.binary.version}</artifactId>
        <version>${scalatest.version}</version>
        <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin><groupId>net.alchim31.maven</groupId><artifactId>scala-maven-plugin</artifactId></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId></plugin>
      
      <!--
        Zero-Spark invariant per ADR-008-AD v1.1.
        Future contributors: this per-module block is REQUIRED (Maven
        inheritance semantics — <build><plugins> in parent does NOT auto-
        apply executions). The block is identical across all non-spark-
        connector modules; when adding a new module, copy this block.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions><execution><id>enforce-no-spark</id><goals><goal>enforce</goal></goals></execution></executions>
        <configuration>
          <rules>
            <bannedDependencies><excludes><exclude>org.apache.spark:*</exclude></excludes></bannedDependencies>
          </rules>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.scalatest</groupId>
        <artifactId>scalatest-maven-plugin</artifactId>
        <executions><execution><id>test</id><goals><goal>test</goal></goals><phase>test</phase></execution></executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <executions><execution><id>attach-sources</id><goals><goal>jar-no-fork</goal></goals></execution></executions>
      </plugin>
    </plugins>
  </build>
</project>
