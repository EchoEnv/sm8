# ============================================================
# SM8 — .gitignore
# ============================================================
# Build output
target/
*/target/
build/
out/

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# VS Code
.vscode/
.project
.classpath
.settings/

# Eclipse / Scala IDE
*.class
*.scala_work_dir
.scala-ide/

# Metals (Scala LSP)
.bsp/
.metals/
project/

# Codegraph MCP index (per-project, auto-created; not a project artifact)
.codegraph/

# Scala Build Server (Bloop) — generated per-IDE; not a project artifact
.bloop/

# Local-only omp advisor watchdog config (per-project; tuned for this repo's
# reviewer roster — not a project artifact)
.omp/

# Coursier / sbt
.cache/
coursier/
ivy2/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Env / secrets
.env
.env.local
*.local

# Maven wrapper jars (if added later)
!/.mvn/wrapper/maven-wrapper.jar