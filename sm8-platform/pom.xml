<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.sm8</groupId>
        <artifactId>sm8-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>sm8-platform_2.13</artifactId>
    <packaging>jar</packaging>

    <name>sm8-platform</name>
    <description>Restructured Scala 2.13 home for what was the Java
        `semanticdf-platform` module. Migrates the engine-portable path
        (QueryService, ModelService, StreamingService, PlatformApplication)
        one method at a time, replacing Java idioms with sealed-trait
        dispatch + ScalaRestate helpers + typed EngineError returns.
        PR-C1 lands the module skeleton + `sealedTypeTag` leaf helper.
        Spark is deliberately not on the classpath — it's a transport-
        free engine-portable platform layer.</description>

    <!-- Inherits scala.version (2.13.18), scala.binary.version (2.13),
         and all dependencyManagement from the parent. -->

    <dependencies>
        <!-- sm8-core provides SealedDataType (PR-C0) + ScalaRestate (PR-0)
             + EngineError + Model + Connector + the rest of the frozen SDK
             + core pipeline. This is the engine-portable foundation. -->
        <dependency>
            <groupId>io.sm8</groupId>
            <artifactId>sm8-core_2.13</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          Cache plugin (default ResultCache impl). Phase 3 of the
          cache-plugin-rehome: the platform depends on this artifact
          (compile-scope, the canonical consumer) for the default
          cache wiring. The platform's own CachePlugin +
          InMemoryResultCache are deleted in this PR — the plugin
          JAR is the only source of caching behavior.
        -->
        <dependency>
            <groupId>io.sm8.plugins</groupId>
            <artifactId>cache-plugin_2.13</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.scala-lang</groupId>
            <artifactId>scala-library</artifactId>
        </dependency>

        <!-- ScalaTest for the engine-portable-path specs. JDK's built-in
             classes (java.util.Optional, java.util.List) cover the Java
             interop surface; no extra test deps needed for PR-C1. -->
        <dependency>
            <groupId>org.scalatest</groupId>
            <artifactId>scalatest_${scala.binary.version}</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- PR-C-final: Restate SDK v2.1.1 (handler-class wiring).
             `sdk-common` carries the API types (ServiceDefinition,
             HandlerDefinition, HandlerContext, HandlerRunner,
             annotations); `sdk-core` carries the HandlerRunner concrete
             implementation; `sdk-http-vertx` carries the HTTP
             transport (RestateHttpServer.listen(endpoint, port)).
             `jackson-module-scala_2.13` is needed because Scala case
             classes (RestateCachedRow, QueryRequest, QueryResult) are
             NOT handled by Jackson out of the box — sdk-serde-jackson
             does NOT bundle the Scala module. The SPI auto-loads the
             SDK's JacksonSerdeFactory via META-INF/services once it's
             on the classpath.
             Per [[scala-jar-packaging-mindset]]: no new fat-jar bloat;
             verified zero Spark transitive deps (recon). -->
        <dependency>
            <groupId>dev.restate</groupId>
            <artifactId>sdk-api</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.restate</groupId>
            <artifactId>sdk-common</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.restate</groupId>
            <artifactId>sdk-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.restate</groupId>
            <artifactId>sdk-http-vertx</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.restate</groupId>
            <artifactId>sdk-serde-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.module</groupId>
            <artifactId>jackson-module-scala_2.13</artifactId>
        </dependency>
        <!-- vertx-core: same artifact as `sdk-http-vertx`'s
             `runtime` transitive; promoted to compile here so
             `RestateBootstrap.bind(...)` can return the
             `io.vertx.core.http.HttpServer` type. The Spark
             transitive (`org.apache.spark:spark-sql_2.13:3.5.8`)
             is unrelated to vertx and conflicts with our
             `bannedDependencies=org.apache.spark:*` enforcer
             rule, so we exclude it here. Per [[scala-jar-packaging-mindset]]:
             every Maven coordinate audited before addition. -->
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-core</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.spark</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>net.alchim31.maven</groupId>
                <artifactId>scala-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.scalatest</groupId>
                <artifactId>scalatest-maven-plugin</artifactId>
                <configuration>
                    <suffixes>Spec</suffixes>
                    <reportsDirectory>${project.build.directory}/surefire-reports</reportsDirectory>
                    <junitxml>.</junitxml>
                    <filereports>sm8-platform-test-suite.txt</filereports>
                </configuration>
            </plugin>

            <!-- PR-C-final: ban Spark at build-time. Templates
                 match sm8-core lines 122-148. Cross-module audit
                 confirmed zero existing `org.apache.spark:*` deps
                 in the reactor, so this rule cannot break the
                 current build; it only enforces going forward.
                 Per [[scala-jar-packaging-mindset]]: every JAR
                 added to the platform must be audited for the
                 forbidden groupId. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <id>enforce-no-spark</id>
                        <goals><goal>enforce</goal></goals>
                    </execution>
                </executions>
                <configuration>
                    <rules>
                        <bannedDependencies>
                            <excludes>
                                <!-- `org.apache.spark:*` covers every
                                     published Spark artifact (spark-core,
                                     spark-sql, spark-catalyst, etc. —
                                     all under the same groupId). The
                                     previous `org.apache.spark.sql:*`
                                     exclude was a no-op (no such
                                     groupId exists). -->
                                <exclude>org.apache.spark:*</exclude>
                            </excludes>
                            <message>
                                sm8-platform must remain Spark-free. Spark
                                classes live in connectors/spark-connector
                                (Step 8 in the migration plan), not in
                                sm8-platform. Move the offending dep
                                there when the connector lands.
                            </message>
                        </bannedDependencies>
                    </rules>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>