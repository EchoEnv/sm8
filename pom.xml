<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    SM8 — Semantic+Automate parent POM.

    Aggregator for the SM8 refactor of semanticdf. Step 1 of the 11-step
    migration plan ships sm8-core as the first child module. The full
    module set (connectors/, plugins/, semanticdf-platform/, etc.) is
    added in subsequent steps.
  -->

  <groupId>io.sm8</groupId>
  <artifactId>sm8-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>SM8 Parent</name>
  <description>SM8 (Semantic+Automate) — frozen-Core + plugin-extensible engine for semantic queries.</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <scala.version>2.13.18</scala.version>
    <scala.binary.version>2.13</scala.binary.version>
    <scalatest.version>3.2.19</scalatest.version>
    <maven.compiler.release>17</maven.compiler.release>
    <!-- Spark engine version. Default 3.5.x; override with
         -Pspark4 (4.1.x). Per scala-spark-batch-bugs-mindset
         mantra #5 (driver vs executor asymmetry): the engine
         version is FROZEN at compile time via Maven; the runtime
         pick is driver-side. No executor-side version negotiation. -->
    <spark.version>3.5.8</spark.version>
    <spark.binary.version>2.13</spark.binary.version>
  </properties>

  <modules>
    <module>sm8-core</module>
    <module>connectors/in-memory-connector</module>
    <module>connectors/trino-connector</module>
    <module>connectors/duckdb-connector</module>
    <module>connectors/spark-connector</module>
    <module>plugins/audit-plugin</module>
    <module>plugins/row-cap-plugin</module>
    <module>plugins/broadcast-plugin</module>
    <module>plugins/cache-plugin</module>
    <module>plugins/materialize-plugin</module>
    <module>plugins/skew-plugin</module>
    <module>plugins/semantic-graph-plugin</module>
    <module>sm8-mcp</module>
    <module>plugins/example-plugin</module>
    <module>sm8-cli</module>
    <module>sm8-server</module>
    <module>sm8-platform</module>
    <!--
      Step 0: sm8-sdk (thin re-export of sm8.sdk)
      Step 8 (more Connectors): spark-connector, duckdb-connector,
        unity-catalog-connector, hive-metastore-connector,
        postgresql-connector
      Steps 10-11: semanticdf-platform, semanticdf-mcp, semanticdf-cli
      (sm8-platform: restructure of semanticdf-platform. PR-C1 lands
      `sm8-platform` module + `sealedTypeTag` Scala helper. Later
      PRs incrementally migrate the legacy Java services.)
    -->
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.scala-lang</groupId>
        <artifactId>scala-library</artifactId>
        <version>${scala.version}</version>
      </dependency>
      <dependency>
        <groupId>org.scalatest</groupId>
        <artifactId>scalatest_${scala.binary.version}</artifactId>
        <version>${scalatest.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>2.15.2</version>
      </dependency>
      <dependency>
        <groupId>com.networknt</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>1.5.2</version>
      </dependency>
      <!-- Restate SDK v2.9.4 (PR-268 upgrade: was v2.1.1).
           All 5 artifacts (sdk-api / sdk-common / sdk-core /
           sdk-http-vertx / sdk-serde-jackson) ship together at the
           same version. API surface verified compatible via javap:
           - dev.restate.sdk.HandlerRunner.of signature unchanged
           - dev.restate.sdk.endpoint.Endpoint still in
             sdk-common-2.9.4.jar
           - dev.restate.sdk.endpoint.definition.{HandlerDefinition,
             HandlerType, ServiceDefinition, ServiceType} unchanged
           - dev.restate.sdk.http.vertx.RestateHttpServer.fromEndpoint(
             Endpoint): HttpServer still exists (new listen(...)
             static variants added; we don't use them)
           - dev.restate.sdk.common.TerminalException unchanged.
           maven MCP confirmed 2.9.4 is the latest stable (29
           versions on Maven Central). 0 CVEs at 2.1.1 → 0 CVEs at
           2.9.4 (no security bump required, only feature parity +
           bug fixes). -->
      <dependency>
        <groupId>dev.restate</groupId>
        <artifactId>sdk-api</artifactId>
        <version>2.9.4</version>
      </dependency>
      <dependency>
        <groupId>dev.restate</groupId>
        <artifactId>sdk-common</artifactId>
        <version>2.9.4</version>
      </dependency>
      <dependency>
        <groupId>dev.restate</groupId>
        <artifactId>sdk-core</artifactId>
        <version>2.9.4</version>
      </dependency>
      <dependency>
        <groupId>dev.restate</groupId>
        <artifactId>sdk-http-vertx</artifactId>
        <version>2.9.4</version>
      </dependency>
      <!-- sdk-serde-jackson: SPI-auto-loaded via
           META-INF/services/dev.restate.serde.provider.DefaultSerdeFactoryProvider.
           Provides JacksonSerdeFactory for `Serde[QueryRequest]` / `Serde[QueryResult]`. -->
      <dependency>
        <groupId>dev.restate</groupId>
        <artifactId>sdk-serde-jackson</artifactId>
        <version>2.9.4</version>
      </dependency>
      <!-- jackson-module-scala for Scala case-class serde
           (NOT bundled with sdk-serde-jackson; required for
           `RestateCachedRow` round-trip via Jackson Serde). -->
      <dependency>
        <groupId>com.fasterxml.jackson.module</groupId>
        <artifactId>jackson-module-scala_2.13</artifactId>
        <version>2.15.2</version>
      </dependency>
      <!-- vertx-core (PR-C-final): transitive `runtime` scope
           from `sdk-http-vertx` is not on the compile classpath;
           promote to compile for the `RestateBootstrap.bind(...)`
           return type. Per [[scala-jar-packaging-mindset]]: we
           only need vertx-core, NOT the full Vert.x stack. -->
      <dependency>
        <groupId>io.vertx</groupId>
        <artifactId>vertx-core</artifactId>
        <version>4.5.11</version>
      </dependency>
      <!-- log4j (PR-C-final): pin both `log4j-api` and `log4j-core`
           to the SAME version (2.20.0 ships in the SDK's transitive
           tree). log4j-api 2.24.2 was dragged in by another transitive
           dep and removed the 3-arg `ServiceLoaderUtil.loadServices`
           method that log4j-core 2.20.0's static init calls →
           `NoSuchMethodError`. Aligning versions avoids the
           incompatibility. Per [[scala-jar-packaging-mindset]] "audit
           jar contents": verified by re-running the spec after the pin. -->
      <dependency>
        <groupId>org.apache.logging.log4j</groupId>
        <artifactId>log4j-api</artifactId>
        <version>2.20.0</version>
      </dependency>
      <dependency>
        <groupId>org.apache.logging.log4j</groupId>
        <artifactId>log4j-core</artifactId>
        <version>2.20.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>net.alchim31.maven</groupId>
          <artifactId>scala-maven-plugin</artifactId>
          <version>4.9.2</version>
          <executions>
            <execution>
              <id>scala-compile</id>
              <goals><goal>compile</goal></goals>
              <phase>process-resources</phase>
            </execution>
            <execution>
              <id>scala-test-compile</id>
              <goals><goal>testCompile</goal></goals>
              <phase>process-test-resources</phase>
            </execution>
            <execution>
              <id>scala-doc-jar</id>
              <goals><goal>doc-jar</goal></goals>
              <phase>package</phase>
            </execution>
          </executions>
          <configuration>
            <scalaVersion>${scala.version}</scalaVersion>
            <args>
              <arg>-deprecation</arg>
              <arg>-feature</arg>
              <arg>-unchecked</arg>
            </args>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <release>${maven.compiler.release}</release>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>3.4.1</version>
        </plugin>
        <plugin>
          <groupId>com.typesafe</groupId>
          <artifactId>mima-maven-plugin</artifactId>
          <version>1.1.3</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>3.3.1</version>
        </plugin>
        <plugin>
          <groupId>org.scalatest</groupId>
          <artifactId>scalatest-maven-plugin</artifactId>
          <version>2.2.0</version>
        </plugin>
        <plugin>
          <groupId>com.spotify.fmt</groupId>
          <artifactId>scalafmt-maven-plugin</artifactId>
          <version>2.5.4</version>
          <configuration>
            <configLocation>${project.basedir}/.scalafmt.conf</configLocation>
            <version>3.10.7</version>
            <fileFilter>.*\.scala$</fileFilter>
            <skip>true</skip>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <!-- Spark 4.x profile: -Pspark4 swaps spark.version from
       3.5.x (default) to 4.1.x. Used by CI to verify the
       spark-connector's stable API subset compiles + tests
       against both versions.

       Per scala-spark-batch-bugs-mindset mantra #5 (driver vs
       executor asymmetry): the engine version is fixed at
       compile time. The runtime pick is driver-side; no
       executor-side version negotiation.

       Per scala-impact-analysis-mindset: the profile changes
       ONLY spark.version. The Scala version (2.13.18), the
       JVM target (17), and the API subset used by
       spark-connector are stable across Spark 3.5 and 4.1. -->
  <profiles>
    <profile>
      <id>spark4</id>
      <properties>
        <spark.version>4.1.1</spark.version>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.scalatest</groupId>
            <artifactId>scalatest-maven-plugin</artifactId>
            <configuration>
              <!-- Spark 4.1 JDK 17 strong-encapsulation
                   requires the same add-opens set as
                   Spark 3.5 plus additional opens for the
                   internal `java.util.concurrent` and
                   `jdk.internal.access` modules that Spark
                   4.x's Kryo serializer accesses. The set
                   here covers both 3.5 and 4.1; 3.5 ignores
                   the extra opens. -->
              <argLine>
--add-opens=java.base/java.lang=ALL-UNNAMED
--add-opens=java.base/java.lang.invoke=ALL-UNNAMED
--add-opens=java.base/java.lang.reflect=ALL-UNNAMED
--add-opens=java.base/java.io=ALL-UNNAMED
--add-opens=java.base/java.net=ALL-UNNAMED
--add-opens=java.base/java.nio=ALL-UNNAMED
--add-opens=java.base/java.util=ALL-UNNAMED
--add-opens=java.base/java.util.concurrent=ALL-UNNAMED
--add-opens=java.base/sun.nio.ch=ALL-UNNAMED
--add-opens=java.base/sun.nio.cs=ALL-UNNAMED
--add-opens=java.base/sun.security.action=ALL-UNNAMED
--add-opens=jdk.internal.access/ALL-UNNAMED=ALL-UNNAMED
              </argLine>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Strict sealed-pattern-match profile: -Pstrict-patmat adds
         `-Xlint:strict-unsealed-patmat` so a missing sealed-trait
         arm (e.g. a new ComparisonOp without a lowering case)
         emits a build-time exhaustivity warning instead of only
         failing with a runtime MatchError. Opt-in by design.

         NOTE: deliberately NOT paired with `-Xfatal-warnings`: the
         spark-connector currently carries several unrelated
         pre-existing warnings (deprecated JavaConverters/varargs
         arrays, two pre-existing non-exhaustive matches in
         MinimalRelOpLowerer), so a blanket fatal-warnings would
         fail the module regardless of the sealed-pattern fix. Once
         those are cleaned, add `-Xfatal-warnings` here to upgrade
         the warning to a hard build error.

         Per scala-bug-hunting-mindset "exhaustive matches":
         compiler-checked exhaustivity is the durable fix for the
         P1-SM8-01 class of bug (missing ComparisonOp.GE arm).
         Scala 2.13.5+ supports the flag. -->
    <profile>
      <id>strict-patmat</id>
      <build>
        <plugins>
          <plugin>
            <groupId>net.alchim31.maven</groupId>
            <artifactId>scala-maven-plugin</artifactId>
            <configuration>
              <scalaVersion>${scala.version}</scalaVersion>
              <args>
                <arg>-deprecation</arg>
                <arg>-feature</arg>
                <arg>-unchecked</arg>
                <arg>-Xlint:strict-unsealed-patmat</arg>
              </args>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>