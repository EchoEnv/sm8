<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    SM8 example Plugin — the copy-and-modify starting point for new
    plugin authors. Registers one PostExecute hook that stamps a
    trace tag into context.meta. Deliberately minimal: no Spark, no
    network, no state beyond one AtomicInteger counter.

    To start your own plugin:
      1. Copy this whole directory and rename it.
      2. Rename the artifactId below and the <name>/<description>.
      3. Rename the package io.sm8.plugins.example to your own.
      4. Rename ExamplePlugin + the hook classes.
      5. Update src/main/resources/META-INF/services/io.sm8.sdk.Plugin
         to list YOUR plugin class.
      6. Update src/main/resources/META-INF/sm8/plugin.properties
         with YOUR groupId/artifactId.
      7. Register the module in the root pom.xml <modules> list.
  -->

  <parent>
    <groupId>io.sm8</groupId>
    <artifactId>sm8-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>example-plugin_2.13</artifactId>
  <packaging>jar</packaging>

  <name>SM8 example Plugin</name>
  <description>Copy-and-modify starting point for new SM8 plugins: one PostExecute hook that stamps a trace tag into context.meta.</description>

  <dependencies>
    <!-- The ONLY compile dependency a plugin needs: the SDK in sm8-core. -->
    <dependency>
      <groupId>io.sm8</groupId>
      <artifactId>sm8-core_2.13</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.scalatest</groupId>
      <artifactId>scalatest_${scala.binary.version}</artifactId>
      <version>${scalatest.version}</version>
      <scope>test</scope>
    </dependency>

    <!--
      Unified conformance bases (HookContractSpec, PluginContractSpec)
      shipped in sm8-core's test-jar artifact (classifier=tests).
      Structural inheritance from these bases is how every plugin in
      this repo proves contract conformance; your plugin should keep
      this dependency and its ContractSpec.
    -->
    <dependency>
      <groupId>io.sm8</groupId>
      <artifactId>sm8-core_2.13</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin><groupId>net.alchim31.maven</groupId><artifactId>scala-maven-plugin</artifactId></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId></plugin>
      <!--
        Plugins are Spark-free by layer discipline: the enforcer
        rejects org.apache.spark:* at build time. Keep this block in
        your copy.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions><execution><id>enforce-no-spark</id><goals><goal>enforce</goal></goals></execution></executions>
        <configuration>
          <rules>
            <bannedDependencies><excludes><exclude>org.apache.spark:*</exclude></excludes></bannedDependencies>
          </rules>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.scalatest</groupId>
        <artifactId>scalatest-maven-plugin</artifactId>
        <executions><execution><id>test</id><goals><goal>test</goal></goals><phase>test</phase></execution></executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <executions><execution><id>attach-sources</id><goals><goal>jar-no-fork</goal></goals></execution></executions>
      </plugin>
    </plugins>
  </build>
</project>
